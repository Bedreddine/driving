# Settings for docker compose. Never commit .env.
# Easiest: ./scripts/docker-env.sh creates .env from this file with fresh random secrets.

# Database password (any long random string). Left empty on purpose: docker compose refuses to start
# until it is set, so the database is never created with a placeholder password.
POSTGRES_PASSWORD=
# Signs login tokens: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Public address of the website (used in emailed links and the QR code). Your domain in production.
SITE_URL=http://localhost:8080
# Port on this machine for the website + API
WEB_PORT=8080

# Trying it locally? `docker compose --profile mail up -d` with SMTP_HOST=mailpit, SMTP_PORT=1025: emails appear at http://localhost:8025
# Client emails through any SMTP server (empty = emails are not sent; the backend log only shows a masked recipient and the subject)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_REPLY_TO=

# Optional
OSRM_URL=https://router.project-osrm.org
# (another geocoder host must also be allowed in docker/nginx.conf, Content-Security-Policy connect-src)
GEOCODER_URL=https://photon.komoot.io
PUSH_ENABLED=true
SMS_ENABLED=false

# Browser push for guests following their ride (standard Web Push, free). ./scripts/docker-env.sh makes the pair
# (or: java -jar app.jar --taxi.generate-vapid). Keep it: browsers subscribed with one key only accept that key.
# Empty = browser push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services in case of problems: a mailto: or https: address
VAPID_SUBJECT=mailto:no-reply@example.com

# Kafka (events between the booking and notification parts) needs no setting here: docker-compose.yml runs it
# and points the backend at it. It uses about 500 MB of RAM.

# Production only (deploy/docker-compose.prod.yml)
# Your domain, without https:// (Caddy gets the certificate for it)
DOMAIN=
# GitHub account that owns the images, in lowercase (ghcr.io/<owner>/driving-backend)
GHCR_OWNER=
# Image version to run: latest, or a commit id to go back
IMAGE_TAG=latest
