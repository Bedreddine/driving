# Settings for docker compose. Copy to .env and fill in. Never commit .env.

# Database password (any long random string)
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Signs login tokens: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-at-least-32-random-characters-please

# Public address of the website (used in emailed links and the QR code). Your domain in production.
SITE_URL=http://localhost:8080
# Port on this machine for the website + API
WEB_PORT=8080

# Trying it locally? `docker compose --profile mail up -d` with SMTP_HOST=mailpit, SMTP_PORT=1025: emails appear at http://localhost:8025
# Client emails through any SMTP server (empty = emails are not sent; the backend log only shows a masked recipient and the subject)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_REPLY_TO=

# Optional
OSRM_URL=https://router.project-osrm.org
# (another geocoder host must also be allowed in docker/nginx.conf, Content-Security-Policy connect-src)
GEOCODER_URL=https://photon.komoot.io
PUSH_ENABLED=true
SMS_ENABLED=false

# Production only (deploy/docker-compose.prod.yml)
# Your domain, without https:// (Caddy gets the certificate for it)
DOMAIN=
# GitHub account that owns the images, in lowercase (ghcr.io/<owner>/driving-backend)
GHCR_OWNER=
# Image version to run: latest, or a commit id to go back
IMAGE_TAG=latest
