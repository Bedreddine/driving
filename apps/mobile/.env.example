# Copy to .env and fill in. Local values come from: npx supabase status
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Address search (Photon, OpenStreetMap). Public server is fine for testing; self-host for production.
EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io
# Search is biased towards this point (Paris by default)
EXPO_PUBLIC_MAP_BIAS_LAT=48.8566
EXPO_PUBLIC_MAP_BIAS_LNG=2.3522
