{
  "expo": {
    "name": "Taxi",
    "slug": "taxi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.taxiapp",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.taxiapp",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-notifications",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pour placer votre point de prise en charge, ou pour montrer votre voiture au client pendant la course. / To set your pickup point, or to show your car to the client during the ride."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour choisir votre photo de chauffeur. / To choose your driver photo."
        }
      ]
    ],
    "scheme": "taxiapp",
    "experiments": {
      "typedRoutes": true
    }
  }
}
