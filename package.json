{
  "name": "taxi-driver",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "backend": "cd backend && ./gradlew :app:bootRun",
    "test:backend": "cd backend && ./gradlew test",
    "test:app": "vitest run --root apps/mobile/src",
    "test": "npm run test:backend && npm run test:app",
    "mobile": "npm --workspace apps/mobile run start",
    "web": "npm --workspace apps/mobile run web"
  },
  "devDependencies": {
    "vitest": "^3"
  }
}
